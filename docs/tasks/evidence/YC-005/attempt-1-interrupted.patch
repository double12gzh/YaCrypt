@@ -206,6 +206,106 @@ class LedgerTests(unittest.TestCase):
         with self.assertRaisesRegex(Error, 'Duplicate'): self.add()
         self.assertEqual(self.ledger.task('one')['state'], 'ready')
 
+    def test_blocked_verdict_fences_attempt_until_stopped_recovery_and_keeps_issues_pass(self):
+        from agy_runner import execute, worktree_digest
+        self.add()
+        first = self.ledger.claim('one', 'author', 'agy', 'main', 3600)
+        head1 = self.commit(first, content='attempt one\n')
+        blocked_report = Path(self.tmp.name) / 'blocked-review.md'
+        blocked_report.write_text('Blocked: upstream interface still undecided.\n')
+        with self.ledger.transaction():
+            task = self.ledger.task('one')
+            task['runs'] = [
+                dict(id='exec-1', role='execute', attempt=1, state='succeeded',
+                     actor='author', requested_model='gemini-test-high',
+                     worktree_digest=worktree_digest(first['worktree'])),
+                dict(id='rev-1', role='review', attempt=1, state='succeeded',
+                     actor='reviewer', requested_model='claude-test-medium',
+                     conversation_id='conv-blocked',
+                     review=dict(head=head1, verdict='BLOCKED'),
+                     **{'response.txt_sha256': __import__('hashlib').sha256(blocked_report.read_bytes()).hexdigest()}),
+            ]
+            self.ledger.save(task, 'fixture_runs')
+        self.ledger.submit('one', first['token'], head1, self.report)
+        reviewed = self.ledger.review('one', 'reviewer', head1, 'BLOCKED', blocked_report)
+        self.assertEqual(reviewed['state'], 'blocked')
+        self.assertEqual(reviewed['review']['verdict'], 'BLOCKED')
+        self.assertEqual(reviewed['review']['evidence']['text'], 'Blocked: upstream interface still undecided.\n')
+
+        with self.assertRaisesRegex(Error, 'running'):
+            self.ledger.renew('one', first['token'], 3600)
+        with self.assertRaisesRegex(Error, 'cannot submit'):
+            self.ledger.submit('one', first['token'], head1, self.report)
+        head1_followup = self.commit(first, content='attempt one unrecovered edit\n')
+        with self.assertRaisesRegex(Error, 'cannot submit'):
+            self.ledger.submit('one', first['token'], head1_followup, self.report)
+        with self.assertRaisesRegex(Error, 'running'):
+            self.ledger.handoff('one')
+        with patch('agy_runner.shutil.which', return_value='/usr/bin/true'), \
+             patch('agy_runner.available_models', return_value={'gemini-test-high': 'Gemini', 'claude-test-medium': 'Claude'}):
+            with self.assertRaisesRegex(Error, 'running'):
+                execute(self.ledger, 'one', 'execute', 'gemini-test-high', 'author', first['token'], 10)
+            with self.assertRaisesRegex(Error, 'submitted'):
+                execute(self.ledger, 'one', 'review', 'claude-test-medium', 'reviewer', None, 10)
+        with self.assertRaisesRegex(Error, 'not ready'):
+            self.claim()
+        with self.assertRaisesRegex(Error, 'Approval'):
+            self.ledger.reserve('one', 'main', 'integrator')
+        with self.assertRaisesRegex(Error, 'stopped'):
+            self.ledger.recover('one', False, 'still running')
+        with self.assertRaisesRegex(Error, 'reason'):
+            self.ledger.recover('one', True, '   ')
+        self.assertEqual(self.ledger.task('one')['state'], 'blocked')
+
+        recovered = self.cli('recover', 'one', '--stopped', '--reason', 'old blocked session stopped')
+        self.assertEqual(recovered.returncode, 0, recovered.stderr)
+        self.assertEqual(json.loads(recovered.stdout)['state'], 'ready')
+        current = self.ledger.task('one')
+        for cleared in ('token', 'expires', 'head', 'submission', 'review', 'execution_run'):
+            self.assertNotIn(cleared, current)
+
+        second = self.claim()
+        self.assertEqual(second['attempt'], 2)
+        self.assertEqual(second['state'], 'running')
+        self.assertNotEqual(second['token'], first['token'])
+        self.assertNotEqual(second['worktree'], first['worktree'])
+        self.assertTrue(Path(first['worktree']).exists())
+        with self.assertRaisesRegex(Error, 'Stale'):
+            self.ledger.renew('one', first['token'], 3600)
+        with self.assertRaisesRegex(Error, 'Stale'):
+            self.ledger.submit('one', first['token'], head1_followup, self.report)
+
+        head2 = self.commit(second, content='attempt two draft\n')
+        self.ledger.submit('one', second['token'], head2, self.report)
+        issues_report = Path(self.tmp.name) / 'issues-review.md'
+        issues_report.write_text('Issues: add missing edge-case assertion.\n')
+        after_issues = self.ledger.review('one', 'reviewer', head2, 'ISSUES', issues_report)
+        self.assertEqual(after_issues['state'], 'running')
+        self.assertEqual(after_issues['attempt'], 2)
+        self.assertEqual(after_issues['review']['verdict'], 'ISSUES')
+        self.assertEqual(self.ledger.renew('one', second['token'], 3600)['state'], 'running')
+        self.assertEqual(self.ledger.handoff('one')['task']['attempt'], 2)
+
+        head2_fixed = self.commit(second, content='attempt two fixed\n')
+        self.ledger.submit('one', second['token'], head2_fixed, self.report)
+        pass_report = Path(self.tmp.name) / 'pass-review.md'
+        pass_report.write_text('Pass: all checks verified.\n')
+        after_pass = self.ledger.review('one', 'reviewer', head2_fixed, 'PASS', pass_report)
+        self.assertEqual(after_pass['state'], 'approved')
+        self.assertEqual(after_pass['review']['verdict'], 'PASS')
+        self.assertEqual(self.ledger.queue(), [dict(id='one', head=head2_fixed, eligible=True)])
+
+        shown = json.loads(self.cli('show', 'one').stdout)
+        reviewed_events = [json.loads(e['body']) for e in shown['events'] if e['kind'] == 'reviewed']
+        self.assertEqual([e['state'] for e in reviewed_events], ['blocked', 'running', 'approved'])
+        self.assertEqual([e['review']['verdict'] for e in reviewed_events], ['BLOCKED', 'ISSUES', 'PASS'])
+        self.assertEqual(reviewed_events[0]['review']['evidence']['text'],
+                         'Blocked: upstream interface still undecided.\n')
+        self.assertEqual(reviewed_events[1]['review']['evidence']['text'],
+                         'Issues: add missing edge-case assertion.\n')
+        self.assertEqual(reviewed_events[2]['review']['evidence']['text'],
+                         'Pass: all checks verified.\n')
+
 
 if __name__ == '__main__':
     unittest.main(verbosity=2)
